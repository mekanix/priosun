# Priosun configuration in TOML format.
# Omitted values use built-in defaults.

bridge = "jails"
bridge_ip = "172.16.0.254"
bridge_ip6 = ":1"
use_ipv4 = true
use_ipv6 = true
network_ip = "172.16.0.253"
network_ip6 = ":2"
domain = ""
ipv6_prefix = "fd10:6c79:8ae5:8b91:"
zfs_pool = "zroot"
bridge_members = []
allow = []
vm_firmware = "/usr/local/share/uefi-firmware/BHYVE_UEFI.fd"
